# Copy this file to .env and fill in the values before running.
# The JWT_SECRET MUST be at least 32 characters long.
JWT_SECRET=your-secret-key-min-32-chars-replace-me-in-production
DB_PASSWORD=your_mysql_root_password
DB_USERNAME=root
ADMIN_EMAIL=admin@youruniversity.edu
ADMIN_PASSWORD=Admin@YourPass1          # min 8 chars, upper+lower+digit+special
ADMIN_NAME="System Administrator"
CORS_ALLOWED_ORIGINS=http://localhost:5173

